[Unit]
Description=Ulanzi D200 Stream Deck Philips Hue Controller Daemon
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/streamdeck/server
ExecStart=/path/to/streamdeck/server/run.sh
Restart=on-failure
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=streamdeck

[Install]
WantedBy=multi-user.target
